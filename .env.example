# Private login password. Use at least 16 characters; never commit real values.
APP_PASSWORD=replace-with-a-long-random-password

# HMAC signing key for login sessions (32+ characters).
SESSION_SECRET=replace-with-32-plus-random-characters

# Supabase Dashboard > Connect > Transaction pooler. Replace [YOUR-PASSWORD].
# Keep the database password secret; URL-encode reserved characters in it.
DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Optional local-only testing controls; never enable on a public server.
# DEV_TOOLS=false
